# Server-side URL used by the same-origin /api/nexus gateway.
# This keeps the real API hostname out of browser configuration.
NEXUS_API_URL=https://<actual-public-nexus-api-domain>

# Optional browser-visible URL for integrations that explicitly need it.
# Do not use localhost in production.
NEXT_PUBLIC_NEXUS_API_URL=https://<actual-public-nexus-api-domain>
