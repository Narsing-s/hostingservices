# Vercel Services injects this automatically from the web -> api binding.
# Do not manually create this value when using the repository vercel.json.
NEXUS_INTERNAL_URL=<injected-by-vercel-service-binding>

# Non-Vercel hosted deployment fallback. Set this only when the API lives at
# a separate public hostname.
NEXUS_API_URL=https://<actual-public-nexus-api-domain>

# Optional browser-visible URL for integrations that explicitly need it.
# Do not use localhost in production.
NEXT_PUBLIC_NEXUS_API_URL=https://<actual-public-nexus-api-domain>
