# Nexus production secrets — replace every placeholder.
NODE_ENV=production
WEB_URL=https://console.example.com
PUBLIC_API_URL=https://api.example.com
DATABASE_URL=postgres://USER:PASSWORD@postgres.example.com:5432/nexus
REDIS_URL=redis://:PASSWORD@redis.example.com:6379
ENGINE_URL=http://engine.internal:4100
PUBLIC_ENGINE_HOST=engine.example.com
RUNTIME_NETWORK=nexus-runtime
AUTH_SECRET=generate-a-long-random-value
SECRETS_ENCRYPTION_KEY=generate-a-separate-32-byte-random-secret
ENGINE_INTERNAL_SECRET=generate-a-separate-long-random-secret
ENGINE_CALLBACK_SECRET=generate-a-random-callback-secret
GITHUB_WEBHOOK_SECRET=generate-a-random-webhook-secret
DOMAIN_VERIFICATION_PREFIX=_nexus-verify
TRAEFIK_ENABLED=true

# Build sandbox. Use a dedicated restricted Docker network in production.
BUILD_NETWORK=bridge
BUILD_MEMORY=2g
BUILD_CPUS=2
BUILD_PIDS_LIMIT=512
BUILD_TIMEOUT_MS=900000
