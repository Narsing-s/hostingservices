# Nexus Hosting environment template
# Copy to your deployment environment; NEVER commit real secrets.

# Web/API public URLs
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Authentication
# Generate a unique 32+ byte random value per environment.
AUTH_SECRET=replace-with-a-long-random-secret

# Database / runtime
DATABASE_URL=postgres://nexus:nexus_dev_only@127.0.0.1:5432/nexus
REDIS_URL=redis://127.0.0.1:6379
ENGINE_URL=http://localhost:4100
ENGINE_CALLBACK_URL=http://127.0.0.1:4000
ENGINE_CALLBACK_SECRET=replace-with-an-internal-secret

# GitHub OAuth App
# ONE OAuth App can serve all Nexus users. Users authorize Nexus individually;
# their GitHub token is stored encrypted server-side and is never sent to the browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# Google OAuth Client (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Production rules:
# - WEB_URL and PUBLIC_API_URL must be the real HTTPS Nexus domains.
# - GITHUB_CALLBACK_URL must exactly match the callback configured in GitHub OAuth Apps.
# - Never put *_SECRET values in the web/frontend service.
# - Use separate OAuth apps/secrets for development, staging, and production.
# - Do not use the localhost callback in production.
